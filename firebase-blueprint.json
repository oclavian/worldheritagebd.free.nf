      "schema": "UmrahPackage",
      "description": "Umrah packages managed via admin"
    },
    "/hajj_packages/{packageId}": {
      "schema": "HajjPackage",
      "description": "Hajj packages managed via admin"
    },
    "/tour_packages/{packageId}": {
